# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=groq
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
# DATABASE_URL=postgresql://user:password@localhost:5432/toolbase_db
SECRET_KEY=change-me
GOOGLE_CLIENT_ID=

# Tool visibility roles: comma-separated admin emails. Admins' adds are
# public (visible to every user); everyone else's adds stay private.
# Example: ADMIN_EMAILS=owner@company.com,curator@company.com
ADMIN_EMAILS=

# --- Appwrite Cloud (OTP auth, users table, Appwrite-table mode) ---
# Console: cloud.appwrite.io -> project Settings (endpoint + project ID),
# API Keys -> toolbase-backend with scopes: databases.read/write,
# storage.read/write, users.read + users.write -> APPWRITE_API_KEY below.
APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=toolbase
APPWRITE_BUCKET_ID=toolbase-media
# 1/true to read+write tools/tags/prompts/artifacts/provider_keys/users
# via Appwrite tables instead of SQLite (JWT identity still enforced)
USE_APPWRITE=

# --- Appwrite Cloud (auth OTP, user DB, tables, storage) ---
# Console: cloud.appwrite.io -> your project -> Settings (endpoint + project ID),
# API Keys -> toolbase-backend (databases.read/write, storage.read/write, users.read)
APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=toolbase
APPWRITE_BUCKET_ID=toolbase-media
# 1/true to read+write tools/tags/prompts/artifacts/provider_keys/users via Appwrite tables
USE_APPWRITE=
