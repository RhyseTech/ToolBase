# Python / backend
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
*.py[cod]
.pytest_cache/
backend/.pytest_cache/
.coverage
htmlcov/

# Stich (Google UI design tool)
stich_assets/
stich_assets_auth/
stich_assets_logo/
stich_assets_new/
stich_assets_shader/


# Databases (local dev data — never commit)
*.db
*.db-journal
*.sqlite
*.sqlite3

# Secrets (never commit real keys)
backend/.env
frontend/.env.local
frontend/.env.*.local
*.pem

# Frontend build output (covered by frontend/.gitignore too)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Stitch design mockups (reference-only binaries already tracked stay tracked;
# new screen fetches stay local)
stitch_assets*/
screen_*.json

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
